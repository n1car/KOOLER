        "method": "GET",
        "url": "{{baseUrl}}/history",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const expectedStatuses = [200];",
              "pm.test(\"Historial del estudiante: estado esperado 200\", () => {",
              "  pm.expect(pm.response.code).to.be.oneOf(expectedStatuses);",
              "});",
              "pm.test('respuesta no vacia', () => { pm.expect(pm.response.responseTime).to.be.below(15000); });"
            ]
          }
        }
      ]
    }
  ]
}
