# Copia este archivo a .env y reemplaza los valores antes de arrancar.
# En producción (Render/Railway) estas variables se configuran en el panel del servicio.

PORT=3000

# Base de datos local (docker compose). En producción use el host interno del proveedor.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=kooler_db
# false en local (docker); true en Neon u otros proveedores que exijan SSL.
DB_SSL=false

# Alternativa en producción/Neon: una sola URL. Si existe, tiene prioridad sobre DB_*.
# Se prefiere la directa (UNPOOLED) porque el backend ejecuta synchronize al iniciar.
# DATABASE_URL_UNPOOLED=postgresql://user:pass@host/db?sslmode=require
# DATABASE_URL=postgresql://user:pass@host-pooler/db?sslmode=require

# Obligatorio. Genere un valor propio, por ejemplo: openssl rand -hex 32
JWT_SECRET=change_me_use_a_long_random_value
JWT_EXPIRES_IN=24h
